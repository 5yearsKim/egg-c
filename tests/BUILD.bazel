load("@rules_cc//cc:cc_test.bzl", "cc_test")

[cc_test(
    name = source[:-4],
    srcs = [source],
    # Resolve the parent package in both standalone and embedded workspaces.
    deps = ["//%s:eggc" % "/".join(package_name().split("/")[:-1])],
    visibility = ["//visibility:public"],
) for source in ["language_test.cpp", "concepts_test.cpp"]]
